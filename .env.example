# Copy to .env and adjust. Values below match docker-compose.yml.

# Host port 5433 is mapped to the Postgres container (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://eve:eve_password@localhost:5433/eve_bookings
TEST_DATABASE_URL=postgresql+psycopg://eve:eve_password@localhost:5433/eve_test

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-in-production-0123456789
JWT_EXPIRE_MINUTES=60

# Shared secret used by the (simulated) payment provider to sign webhooks
WEBHOOK_SECRET=dev-only-webhook-secret-change-me

LOG_LEVEL=INFO
LOGIN_RATE_LIMIT=5/minute
